    "react": "^19.2.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "tailwindcss": "^4.0.6",
    "zod": "^4.6.5"
  },
