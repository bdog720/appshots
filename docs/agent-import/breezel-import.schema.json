                "color": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                }
              },
              "required": [
                "type",
                "color"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "gradient"
                },
                "from": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                }
              },
              "required": [
                "type",
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "preset"
                },
                "id": {
                  "type": "string",
                  "enum": [
                    "sunset",
                    "ocean",
                    "mint",
                    "berry",
                    "royal",
                    "rose"
