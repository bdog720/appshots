  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "appshots-import"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "exportSize": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "style": {
          "type": "string",
          "enum": [
            "minimal",
            "bold",
            "warm",
            "playful",
            "elegant",
            "editorial"
          ]
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "textColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "highlightColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "headlineSize": {
          "type": "number",
          "minimum": 12,
          "maximum": 200
        },
        "subheadlineSize": {
          "type": "number",
          "minimum": 12,
          "maximum": 200
        },
        "background": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
