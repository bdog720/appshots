                "rotation": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "shadow": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": {
